# top-most EditorConfig file
root = true

[*]
indent_style = space

[*.{json,asmdef}]
indent_size = 2

[Assets/_Core/Scripts/**/*.cs]
roslynator_analyzers.enabled_by_default = true
indent_size = 4
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true
charset = utf-8

# Use language keywords instead of framework type names for type references
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Suggest acessibility modifier is redundant 
dotnet_style_require_accessibility_modifiers = never:suggestion

# Prefer "var" everywhere
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Prefer braces even on single line
csharp_prefer_braces = true:suggestion
csharp_preserve_single_line_blocks = true

# Const must be all upper
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols  = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.constant_fields.applicable_kinds   = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = all_upper

# 필드 네이밍 (private _camelCase)
dotnet_naming_rule.private_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_with_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_case_with_underscore.required_prefix = _

# Protected must start with lower with camel case
dotnet_naming_rule.protected_should_be_pascal_case.severity = warning
dotnet_naming_rule.protected_should_be_pascal_case.symbols  = protected_fields
dotnet_naming_rule.protected_should_be_pascal_case.style    = protected_pascal_case_style
dotnet_naming_symbols.protected_fields.applicable_kinds   = field
dotnet_naming_symbols.protected_fields.required_modifiers = protected
dotnet_naming_symbols.protected_fields.applicable_accessibilities = protected
dotnet_naming_style.protected_pascal_case_style.capitalization = PascalCase
dotnet_naming_style.protected_pascal_case_style.required_prefix = m_

# Public fields should be camel case
dotnet_naming_rule.public_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.public_fields_should_be_camel_case.symbols  = public_fields
dotnet_naming_rule.public_fields_should_be_camel_case.style    = public_fields_camel_case_style
dotnet_naming_symbols.public_fields.applicable_kinds   = field
dotnet_naming_symbols.public_fields.required_modifiers = public
dotnet_naming_symbols.public_fields.applicable_accessibilities = public
dotnet_naming_style.public_fields_camel_case_style.capitalization = camel_case

# Public enum constants, and classes must be PascalCase
dotnet_naming_rule.pascal_case_for_public_enum_and_classes_static_fields.severity = warning
dotnet_naming_rule.pascal_case_for_public_enum_and_classes_static_fields.symbols  = enum_member, class
dotnet_naming_rule.pascal_case_for_public_enum_and_classes_static_fields.style    = public_pascal_case_style
dotnet_naming_symbols.enum_member.applicable_kinds   = enum_member
dotnet_naming_symbols.enum_member.required_modifiers = none
dotnet_naming_symbols.enum_member.applicable_accessibilities = public
dotnet_naming_symbols.class.applicable_kinds   = class
dotnet_naming_symbols.class.required_modifiers = none
dotnet_naming_symbols.class.applicable_accessibilities = public
dotnet_naming_style.public_pascal_case_style.capitalization = pascal_case

# Public static readonly fields should be PascalCase
dotnet_naming_rule.pascal_case_for_public_static_readonly_fields.severity = warning
dotnet_naming_rule.pascal_case_for_public_static_readonly_fields.symbols  = public_static_readonly_fields
dotnet_naming_rule.pascal_case_for_public_static_readonly_fields.style    = public_static_readonly_pascal_case_style
dotnet_naming_symbols.public_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.public_static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_symbols.public_static_readonly_fields.applicable_accessibilities = public
dotnet_naming_style.public_static_readonly_pascal_case_style.capitalization = pascal_case

# for parameters
dotnet_naming_symbols.parameter_symbol.applicable_kinds = parameter
dotnet_naming_style.parameter_style.capitalization = camel_case
dotnet_naming_rule.parameters_are_camel_case.severity = warning
dotnet_naming_rule.parameters_are_camel_case.symbols = parameter_symbol
dotnet_naming_rule.parameters_are_camel_case.style = parameter_style

# Interface must be pascal start with I
dotnet_naming_rule.pascal_case_for_interface.severity = warning
dotnet_naming_rule.pascal_case_for_interface.symbols  = interface
dotnet_naming_rule.pascal_case_for_interface.style    = interface_pascal_case_style
dotnet_naming_symbols.interface.required_modifiers = interface
dotnet_naming_symbols.interface.applicable_kinds   = interface
dotnet_naming_style.interface_pascal_case_style.capitalization = pascal_case
dotnet_naming_style.interface_pascal_case_style.required_prefix     = I

# Local variables should use camelCase
dotnet_naming_rule.local_variables_should_be_camel_case.severity = warning
dotnet_naming_rule.local_variables_should_be_camel_case.symbols = local_variable
dotnet_naming_rule.local_variables_should_be_camel_case.style = local_variable_camel_case_style
dotnet_naming_symbols.local_variable.applicable_kinds = local
dotnet_naming_symbols.local_variable.applicable_accessibilities = local
dotnet_naming_symbols.local_variable.required_modifiers =
dotnet_naming_style.local_variable_camel_case_style.capitalization = camel_case

# Limit Line Length
max_line_length = 120

# using 정렬
dotnet_sort_system_directives_first = true
remove_unused_directives = true

# For unity
roslynator_unity_code_analysis.enabled = true
dotnet_diagnostic.CS0649.severity = none